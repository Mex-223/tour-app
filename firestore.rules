rules_version = '2';

// Security rules for the Tour App.
// Paste this whole file into Firebase → Firestore Database → Rules → Publish.
//
// In plain words:
// - You must be logged in to do anything.
// - Your profile (users/{you}) is only readable and writable by you.
// - You only see a band (and its members and events) if you are a member.
// - Only MGMT of a band can change events, the band, roles and invite links.
// - You can join a band only with a valid invite code, and only as "member".
// - You can always change your own name/instrument or leave a band.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc(bandId) { return /databases/$(database)/documents/bands/$(bandId)/members/$(request.auth.uid); }
    function isMember(bandId) { return signedIn() && exists(memberDoc(bandId)); }
    function isMgmt(bandId) { return isMember(bandId) && get(memberDoc(bandId)).data.role == 'mgmt'; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    // ---------- Profiles ----------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Bands ----------
    match /bands/{bandId} {
      allow read: if isMember(bandId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow update: if isMgmt(bandId)
        && request.resource.data.createdBy == resource.data.createdBy
        && onlyChanges(['name', 'color', 'inviteCode']);
      allow delete: if isMgmt(bandId);

      // ---------- Members ----------
      match /members/{uid} {
        allow read: if isMember(bandId);

        // 1) The person who just created the band becomes its first MGMT.
        // 2) Anyone else joins as "member" with a valid invite code for this band.
        allow create: if signedIn() && request.auth.uid == uid && (
          (request.resource.data.role == 'mgmt'
            && !exists(/databases/$(database)/documents/bands/$(bandId))
            && getAfter(/databases/$(database)/documents/bands/$(bandId)).data.createdBy == request.auth.uid)
          ||
          (request.resource.data.role == 'member'
            && request.resource.data.invite is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.bandId == bandId)
        );

        // MGMT can change roles; everyone can update their own name/instrument (not their role).
        allow update: if isMgmt(bandId)
          || (signedIn() && request.auth.uid == uid && onlyChanges(['name', 'instrument']));

        // MGMT can remove people; everyone can leave.
        allow delete: if isMgmt(bandId) || (signedIn() && request.auth.uid == uid);
      }

      // ---------- Events ----------
      match /events/{eventId} {
        allow read: if isMember(bandId);
        allow create, update, delete: if isMgmt(bandId);
      }
    }

    // ---------- Invite links ----------
    // Only readable if you know the exact code (no listing all invites).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMgmt(request.resource.data.bandId);
      allow delete: if signedIn() && isMgmt(resource.data.bandId);
    }
  }
}
