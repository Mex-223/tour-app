rules_version = '2';

// Security rules for the Tour App.
// Paste this whole file into Firebase → Firestore Database → Rules → Publish.
//
// In plain words:
// - You must be logged in to do anything.
// - Your profile (users/{you}) is only readable and writable by you.
// - You only see a band (and its members and events) if you are a member.
// - Only MGMT of a band can change events, the band, roles and invite links.
// - The band's Owner (field createdBy) can't be demoted or removed by anyone,
//   and only the Owner can hand the lead over to another MGMT.
// - You can join a band only with a valid invite code, and only as "member".
// - You can always change your own name/instrument or leave a band.
// - Members can suggest events (MGMT accept or decline) and add their own
//   "not available" dates.
// - Merch: MGMT set up products, photos, bundles and what things cost (costs
//   are MGMT only). Every member can sell, move stock and count the cash box.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc(bandId) { return /databases/$(database)/documents/bands/$(bandId)/members/$(request.auth.uid); }
    function isMember(bandId) { return signedIn() && exists(memberDoc(bandId)); }
    function isMgmt(bandId) { return isMember(bandId) && get(memberDoc(bandId)).data.role == 'mgmt'; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function ownerOf(bandId) { return get(/databases/$(database)/documents/bands/$(bandId)).data.createdBy; }
    function isOwner(bandId) { return signedIn() && ownerOf(bandId) == request.auth.uid; }

    // ---------- Profiles ----------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Bands ----------
    match /bands/{bandId} {
      allow read: if isMember(bandId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      // MGMT can change name, colour and the invite link.
      // Only the Owner can hand over the lead (createdBy), and only to another MGMT.
      allow update: if (isMgmt(bandId)
          && request.resource.data.createdBy == resource.data.createdBy
          && onlyChanges(['name', 'color', 'inviteCode']))
        || (isOwner(bandId)
          && onlyChanges(['createdBy'])
          && get(/databases/$(database)/documents/bands/$(bandId)/members/$(request.resource.data.createdBy)).data.role == 'mgmt');
      allow delete: if isOwner(bandId);

      // ---------- Members ----------
      match /members/{uid} {
        allow read: if isMember(bandId);

        // 1) The person who just created the band becomes its first MGMT.
        // 2) Anyone else joins as "member" with a valid invite code for this band.
        allow create: if signedIn() && request.auth.uid == uid && (
          (request.resource.data.role == 'mgmt'
            && !exists(/databases/$(database)/documents/bands/$(bandId))
            && getAfter(/databases/$(database)/documents/bands/$(bandId)).data.createdBy == request.auth.uid)
          ||
          (request.resource.data.role == 'member'
            && request.resource.data.invite is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.bandId == bandId)
        );

        // MGMT can change roles of everyone except the Owner;
        // everyone can update their own name/instrument (not their role).
        allow update: if (isMgmt(bandId) && uid != ownerOf(bandId))
          || (signedIn() && request.auth.uid == uid && onlyChanges(['name', 'instrument', 'phone', 'sharePhone']));

        // MGMT can remove people (not the Owner); everyone except the Owner can leave.
        // (When the Owner deletes the whole band, its member list goes with it.)
        allow delete: if (isOwner(bandId) && !existsAfter(/databases/$(database)/documents/bands/$(bandId)))
          || (uid != ownerOf(bandId) && (isMgmt(bandId) || (signedIn() && request.auth.uid == uid)));
      }

      // ---------- Events ----------
      // MGMT plan events. Members can only add *suggestions* (marked as theirs),
      // and withdraw their own suggestions. MGMT accept (update) or decline (delete).
      match /events/{eventId} {
        allow read: if isMember(bandId);
        allow create: if isMgmt(bandId)
          || (isMember(bandId)
            && request.resource.data.suggested == true
            && request.resource.data.suggestedBy == request.auth.uid);
        allow update: if isMgmt(bandId);
        allow delete: if isMgmt(bandId)
          || (isMember(bandId)
            && resource.data.suggested == true
            && resource.data.suggestedBy == request.auth.uid);
      }

      // Team contacts and document links: the band can see them, MGMT edit them.
      match /contacts/{contactId} {
        allow read: if isMember(bandId);
        allow write: if isMgmt(bandId);
      }
      match /docs/{docId} {
        allow read: if isMember(bandId);
        allow write: if isMgmt(bandId);
      }
      // Contracts, fees etc.: MGMT only.
      match /privateDocs/{docId} {
        allow read, write: if isMgmt(bandId);
      }

      // ---------- Merch ----------
      // Products: MGMT add/edit/delete. Members may only change the stock counts (selling, moving).
      match /products/{productId} {
        allow read: if isMember(bandId);
        allow create, delete: if isMgmt(bandId);
        allow update: if isMgmt(bandId) || (isMember(bandId) && onlyChanges(['stock']));
      }
      // Product photos (small, compressed). Max ~400 KB each.
      match /photos/{photoId} {
        allow read: if isMember(bandId);
        allow write: if isMgmt(bandId) && request.resource.data.data is string && request.resource.data.data.size() < 400000;
        allow delete: if isMgmt(bandId);
      }
      // What a product cost us: MGMT only.
      match /costs/{productId} {
        allow read, write: if isMgmt(bandId);
      }
      match /bundles/{bundleId} {
        allow read: if isMember(bandId);
        allow write: if isMgmt(bandId);
      }
      // Sales: every member can sell (saved under their name) and undo their own sale.
      match /sales/{saleId} {
        allow read: if isMember(bandId);
        allow create: if isMember(bandId) && request.resource.data.by == request.auth.uid;
        allow update: if isMgmt(bandId);
        allow delete: if isMgmt(bandId) || (isMember(bandId) && resource.data.by == request.auth.uid);
      }
      // Show nights at the merch table (cash box float, counted cash, closed).
      match /nights/{nightId} {
        allow read, write: if isMember(bandId);
      }

      // "Not available" dates: every member manages their own; the band can see them.
      match /away/{awayId} {
        allow read: if isMember(bandId);
        allow create: if isMember(bandId) && request.resource.data.uid == request.auth.uid;
        allow update: if isMember(bandId) && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isMgmt(bandId);
      }
    }

    // ---------- Invite links ----------
    // Only readable if you know the exact code (no listing all invites).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMgmt(request.resource.data.bandId);
      allow delete: if signedIn() && isMgmt(resource.data.bandId);
    }
  }
}
